PROJECT_NAME="CivicEye AI"
API_V1_STR="/api"

# IMPORTANT: Generate a strong random secret for production
# Example (Linux/Mac): openssl rand -hex 32
# Example (Python): python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_ME_generate_a_strong_random_secret_key_min_32_chars"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (MySQL preferred; automatically falls back to SQLite if unreachable)
DATABASE_URL="mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/civiceye_ai"
SQLITE_FALLBACK_URL="sqlite:///./civiceye.db"

# Storage directory for uploaded issue images
UPLOAD_DIR="./uploads"

# Production Environment
ENVIRONMENT="production"

# Initial Administrator Account (used only on first-ever startup or manual init)
INITIAL_ADMIN_EMAIL="admin@your-city-domain.gov"
INITIAL_ADMIN_PASSWORD="ChangeThisStrongPassword2026!"
INITIAL_ADMIN_NAME="System Administrator"
